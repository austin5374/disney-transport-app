{
  "expo": {
    "name": "Walt Disney World Transportation",
    "slug": "disney-transport-app",
    "version": "3.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "scheme": "wdwtransport",
    "primaryColor": "#0B79D0",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E5490"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.austinvodrazka.wdwtransport",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used to detect which park or resort area you are currently at."
      }
    },
    "android": {
      "package": "com.austinvodrazka.wdwtransport",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E5490"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Walt Disney World Transportation",
      "shortName": "WDW Transport",
      "description": "Plan a trip across Walt Disney World transportation: monorails, the Skyliner, boats, and buses. Routes ranked by total journey time, including the wait.",
      "themeColor": "#0B79D0",
      "backgroundColor": "#0E5490"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to detect which park or resort area you are at."
        }
      ]
    ]
  }
}
